# Copy to .env and fill in your values
TRADIER_API_TOKEN_SANDBOX="Qj733j2d7UTPTAUJXAGzbyvSpVem"
TRADIER_ACCOUNT_ID_SANDBOX="VA92357805"
TRADIER_BASE_URL_SANDBOX=https://sandbox.tradier.com/v1

TRADIER_BASE_URL=https://api.tradier.com/v1
TRADIER_API_TOKEN="MYSx6GrB71rKDx1XaXmLBbQFZGpD"
TRADIER_ACCOUNT_ID="6YB81397"

# ── Trading mode ──────────────────────────────────────────────────────────
# 1 = sandbox / paper trading (safe default)
# 0 = LIVE REAL MONEY — flip this when ready to go live
USE_SANDBOX=0

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./ajoy.db

# ── Scheduler ─────────────────────────────────────────────────────────
SCHEDULER_ENABLED=1
SCAN_INTERVAL_SECONDS=60      # S1 entry scan frequency
S2_SCAN_INTERVAL_SECONDS=30   # S2 entry scan frequency (shorter to catch the 2-bar pullback+confirm window)
MANAGE_INTERVAL_SECONDS=30    # open-trade management frequency

# ── Trading session window (America/New_York) ─────────────────────────
# Entry-hour PnL (Jun 8 – Jul 7 live): S1 was profitable only 11:00–12:59
# (+$32 at 11, +$76 at 12 — noon was its BEST hour) and bled from 13:00 on
# (−$376 at 13, −$138 at 14).  Last entry 13:00 keeps the full noon hour.
TRADING_START_TIME=11:00
TRADING_END_TIME=15:50
LAST_ENTRY_TIME=13:00
MAX_OPEN_TRADES=1

# ── Position sizing ────────────────────────────────────────────────────
AMOUNT_PER_TRADE=500
MAX_DAILY_LOSS=500

# Fixed-dollar risk sizing: qty = RISK_PER_TRADE / (entry × STOP_LOSS_PCT × 100)
# Every trade risks ~the same $ at its stop. AMOUNT_PER_TRADE still caps premium.
# If 1 contract exceeds either limit the trade is SKIPPED (no more $880 TSLA entries
# on a $450 budget). 120 ≈ old implied risk (450 × 0.27). Set 0 to disable.
RISK_PER_TRADE=150

# Broker-side resting stop order placed after every entry fill — protects the
# position even if the bot process dies. Bot raises it with the trailing stop
# and cancels it before its own exits. Set 0 to disable.
BROKER_STOP_ENABLED=0
BROKER_TP_ENABLED=1

# ── Risk / reward levels ───────────────────────────────────────────────
#
#   v1 — simple single-target exits, 100% of position at each level.
#   Example with entry @ $5.00:
#     stop   = $5.00 × (1 − 0.25) = $3.75   (−25%)
#     target = $5.00 × (1 + 0.35) = $6.75   (+35%)
#
STOP_LOSS_PCT=0.19
TAKE_PROFIT_PCT=0.22

# ── Limit order entry ──────────────────────────────────────────────────────
USE_LIMIT_ORDERS=1            # 1 = enter at (bid+ask)/2 via limit; 0 = market at ask
LIMIT_ORDER_TIMEOUT_SECONDS=30   # cancel unfilled limit orders after this many seconds

# ── Limit order exits ───────────────────────────────────────────────────────
# Patient exits (TP2, RUNNER, TRAILING_STOP, STRUCT_EXIT, EMA_CROSS,
# TREND_REVERSAL, CUTOFF, MANUAL) try a limit at the mid first, then cancel
# and market-sell after the timeout.  Partial limit fills are booked exactly.
# Urgent exits (STOP, QUICK_LOSS, VWAP_BREAK) always market-sell immediately —
# chasing a falling market with a limit costs more than the half-spread saves.
EXIT_LIMIT_ORDERS_ENABLED=1
EXIT_LIMIT_TIMEOUT_SECONDS=12

# ── Trailing stop ──────────────────────────────────────────────────────────
TRAILING_STOP_BREAKEVEN_PCT=0.15
TRAILING_STOP_LOCK_PROFIT_PCT=0.02
TRAILING_STOP_TRAIL_PCT=0.18
TRAILING_STOP_TRAIL_FROM_CURRENT_PCT=0.1
TRAILING_STOP_MIN_HOLD_MINUTES=10

# ── Layer 5: Market regime gate (QQQ VWAP position) ───────────────────────
REGIME_GATE_ENABLED=1         # 1 = on; 0 = off (allow all directions regardless of market)
REGIME_GATE_SYMBOL=QQQ        # regime proxy — always QQQ (no circular ref when trading SPY)
REGIME_GATE_TTL_SECONDS=300   # unused (VWAP gate is real-time per scan cycle)
REGIME_VWAP_THRESHOLD=0.002   # 0.2% — QQQ must be this far from its VWAP to declare regime
                               # < threshold → NEUTRAL (allow all); ≥ threshold → BULL/BEAR gate

# ── Layer 6: IV filter ─────────────────────────────────────────────────
IV_MAX_THRESHOLD=1.75         # skip if ATM IV > 150% (too expensive)

# ── Layer 4 tuning ─────────────────────────────────────────────────────
VWAP_SLOPE_LOOKBACK_BARS=20   # compare VWAP now vs N 1-min bars ago
VWAP_SLOPE_THRESHOLD_PCT=0.08 # block if |slope| exceeds 0.05%

# ── Structural (chart-based) stop / target levels ──────────────────────
# Stops anchor to the setup's invalidation point (pullback low / VWAP for S1,
# pullback low / 5m-EMA9 for S2); targets anchor to the session swing
# high/low.  Both are translated to option prices via the contract delta.
# Entries without ≥ STRUCT_MIN_REWARD_RISK room to the target are SKIPPED.
# Position size = RISK_PER_TRADE dollars at the structural stop.
# When enabled, the S1 VWAP_BREAK band exit is disabled (the structural stop
# replaces it — the 0.3% band was firing inside normal underlying noise).
STRUCTURAL_LEVELS_ENABLED=1
STRUCT_STOP_BUFFER_PCT=0.001
STRUCT_PULLBACK_LOOKBACK=10
STRUCT_MIN_STOP_PCT=0.08
STRUCT_MAX_STOP_PCT=0.30
STRUCT_MIN_REWARD_RISK=1.2
STRUCT_DISABLE_VWAP_BREAK=1

# ── Runner mode (S1 + S2) ───────────────────────────────────────────────
# When the bid gets within RUNNER_PROXIMITY_PCT of the TP AND the last
# completed 1-min candle still shows momentum in the trade direction, the
# fixed TP is waived and the trade trails RUNNER_TRAIL_PCT below the price
# instead (broker resting TP is cancelled).  Exits label as RUNNER.
# Without momentum at the target, the TP fires normally.
RUNNER_MODE_ENABLED=1
RUNNER_PROXIMITY_PCT=0.05
RUNNER_TRAIL_PCT=0.08

# ── Chop-day regime filter (QQQ session range vs daily ATR) ─────────────
# Blocks ALL new entries (S1 + S2) while QQQ's session range is below
# CHOP_MIN_RANGE_RATIO of its daily ATR(14).  Live results: both strategies
# were only profitable in trending weeks; choppy weeks bled −$380 each.
CHOP_FILTER_ENABLED=1
CHOP_ATR_PERIOD=14
CHOP_MIN_RANGE_RATIO=0.5
CHOP_FILTER_START_TIME=10:30

# ── VWAP exit band (tighter than entry band) ───────────────────────────
# VWAP_BREAK exit fires when underlying crosses this far past entry VWAP.
# Must be much smaller than VWAP_BAND_PCT (entry) so it fires before the
# hard stop on high-gamma near-expiry options.
# e.g. 0.003 = 0.3% → for $580 SPY, fires at $578.26 below entry VWAP.
VWAP_EXIT_BAND_PCT=0.003

# ── Pre-entry guards ───────────────────────────────────────────────────
COOLDOWN_MINUTES=30
MAX_LOSSES_PER_SYMBOL_PER_DAY=2
MAX_TRADES_PER_SYMBOL_PER_DAY=2

# ── Exit guards ────────────────────────────────────────────────────────────
# Hard stop minimum hold: don't fire the hard stop until this many minutes
# after entry. Lets the trade breathe past initial noise. Quick-loss (below)
# is the emergency brake during this window.
STOP_LOSS_MIN_HOLD_MINUTES=15

# Quick-loss early exit: fires if option drops QUICK_LOSS_PCT within the
# time window [QUICK_LOSS_MIN_HOLD_MINUTES … QUICK_LOSS_MAX_MINUTES].
# Acts as emergency brake while the hard stop is suppressed (first 15 min).
#   MIN_HOLD = quiet period after entry before quick-loss arms (0 = immediate)
#   MAX_MINUTES = upper bound — quick-loss disabled after this many minutes
QUICK_LOSS_PCT=0.18
QUICK_LOSS_MIN_HOLD_MINUTES=14
QUICK_LOSS_MAX_MINUTES=15

TREND_REVERSAL_MIN_HOLD_MINUTES=10
TREND_REVERSAL_CONFIRM_BARS=1
TREND_REVERSAL_COOLDOWN_MINUTES=60

# ── Lunch-hour noise filter ────────────────────────────────────────────
LUNCH_BREAK_ENABLED=0
LUNCH_BREAK_START=12:01       # ET time to stop entries (HH:MM)
LUNCH_BREAK_END=12:28        # ET time to resume entries (HH:MM)

# ── Strategy params ────────────────────────────────────────────────────
EMA_PERIOD=21
# Reduced 2 → 1 (Jul 2026): with 2 confirmation bars + the momentum candle,
# entries landed 3+ bars after the bounce — buying the local top ~0.5% from
# VWAP.  One directional close above/below VWAP + the L3 momentum candle
# still confirms the bounce, but 1 bar earlier and closer to the level.
BOUNCE_BARS_REQUIRED=1
EMA_CONSECUTIVE_BARS=2
EMA_1M_MIN_MARGIN_PCT=0.001
VWAP_MIN_CLEARANCE_PCT=0.004
VWAP_BAND_PCT=0.014
TREND_LOOKBACK_DAYS=5         # trading days of 15-min bars to fetch for EMA trend

# ── Adaptive VWAP band (QQQ-based) ────────────────────────────────────────
# QQQ distance from VWAP → effective band applied to all symbol entries:
#   QQQ < 0.5% from VWAP → normal  band (VWAP_BAND_PCT      = 0.9%)
#   QQQ 0.5–1.5%         → relaxed band (VWAP_BAND_RELAXED_PCT = 1.3%)
#   QQQ > 1.5%           → wider   band (VWAP_BAND_WIDER_PCT   = 1.8%)
ADAPTIVE_BAND_ENABLED=0
ADAPTIVE_BAND_SYMBOL=QQQ
ADAPTIVE_BAND_RELAXED_THRESHOLD=0.005
ADAPTIVE_BAND_WIDER_THRESHOLD=0.015
VWAP_BAND_RELAXED_PCT=0.013
VWAP_BAND_WIDER_PCT=0.019

# ── Indicator thresholds ───────────────────────────────────────────────
RSI_PERIOD=14
RSI_OVERSOLD=45
RSI_OVERBOUGHT=55
VOLUME_SPIKE_MULTIPLIER=2.0
VOLUME_SPIKE_LOOKBACK=20
PCR_BULLISH_ABOVE=1.1
PCR_BEARISH_BELOW=0.9

# ── Option contract selection ──────────────────────────────────────────
OPTION_MIN_DELTA=0.30         # skip deep OTM contracts
OPTION_MAX_DELTA=0.55         # skip deep ITM contracts
OPTION_MIN_VOLUME=10          # skip illiquid contracts

TP_COOLDOWN_MINUTES=30
TP_CHASE_PCT=0.15          # block same-direction re-entry if new option price > last TP entry × 1.15

# ══════════════════════════════════════════════════════════════════════════════
# Strategy 2 — EMA Pullback
#
# Entry (3-step, all must pass):
#   Step 1 — 5-min Trend Filter (cached per candle close):
#     CALL : EMA9 > EMA21  AND  Close > VWAP  AND  EMA9 slope↑  AND  EMA21 slope↑
#     PUT  : EMA9 < EMA21  AND  Close < VWAP  AND  EMA9 slope↓  AND  EMA21 slope↓
#   Step 2 — 1-min Pullback (previous completed bar):
#     CALL : prev-bar Low  ≤ 5m-EMA9   OR  Close within 0.10% of 5m-EMA9
#     PUT  : prev-bar High ≥ 5m-EMA9   OR  Close within 0.10% of 5m-EMA9
#   Step 3 — 1-min Confirmation (most recent completed bar):
#     CALL : bullish candle (close > open)  AND  close > pullback-bar High
#     PUT  : bearish candle (close < open)  AND  close < pullback-bar Low
#
# Exit (priority order):
#   1. Hard stop     : option drops S2_STOP_LOSS_PCT from entry
#   2. Trailing stop : breakeven at S2_BREAKEVEN_PCT → trail S2_TRAIL_FROM_CURRENT_PCT below current at S2_TRAIL_PCT
#   3. EMA cross     : opposite EMA(9)/EMA(21) cross on 5-min bars
# ══════════════════════════════════════════════════════════════════════════════
S2_ENABLED=1

# EMA periods — used for 5-min trend filter (entry) and 5-min EMA cross (exit)
S2_EMA_FAST=9
S2_EMA_SLOW=21

# Entry guards
S2_COOLDOWN_MINUTES=20
S2_MAX_SPREAD_PCT=0.3
S2_MAX_TRADES_PER_DAY=2

# S2 PUT-side guards — live results (Jun 8–Jul 7) showed S2 PUTs 4W/14L (−$554),
# almost all fired on 5-min dips inside larger 15-min uptrends.
# S2_PUTS_ENABLED=0     → kill switch: no S2 PUT entries at all
# S2_PUT_15M_STRICT=1   → PUT requires confirmed BEARISH 15-min trend
#                         (neutral or missing 15-min data blocks the PUT;
#                          CALL behaviour unchanged — only opposing trend blocks)
S2_PUTS_ENABLED=1
S2_PUT_15M_STRICT=1

# Risk & sizing
S2_AMOUNT_PER_TRADE=600
S2_RISK_PER_TRADE=120
S2_MAX_OPEN_TRADES=1

# TP price-chase guard: block same-direction S2 re-entry if new option price
# is more than this % above the last profitable entry price (0 = disabled).
S2_TP_CHASE_PCT=0.12

# Exit levels
S2_STOP_LOSS_PCT=0.19
S2_STOP_LOSS_MIN_HOLD_MINUTES=10
S2_TAKE_PROFIT_PCT=0.24
S2_BREAKEVEN_PCT=0.15
S2_TRAIL_PCT=0.2
# Raised 0.01 → 0.08 (Jul 2026): a 1% trail below mid stops out on the first
# tick of noise — the exit fills at the bid, often 5–10% below mid on cheap
# options, so "trailing" exits were landing at a net LOSS (live data: 16
# S2 TRAILING_STOP exits averaging −$41).  8% gives winners room to run.
S2_TRAIL_FROM_CURRENT_PCT=0.08
# Lock-profit at breakeven: raise stop to entry × (1 + this) instead of plain entry.
# Covers bid-ask spread cost — ensures the exit is net positive after commission.
S2_TRAILING_STOP_LOCK_PROFIT_PCT=0.03
# Quick-loss: exit immediately if option drops ≥ this % in the first N minutes.
# Prevents riding a bad entry all the way to the hard stop.
S2_QUICK_LOSS_PCT=0.19
S2_QUICK_LOSS_MIN_HOLD_MINUTES=5   # 0 = arms immediately; increase to give the trade breathing room
S2_QUICK_LOSS_MAX_MINUTES=10         # only active in the first 5 minutes

# ── S2 structure exit (replaces the 5-min EMA9/21 cross signal exit) ────
# Exit when the last N completed 1-min bars close back through the 5-min
# EMA9 (the level the entry bounced off).  Reacts in 2–3 minutes; the old
# 5-min cross took 10–15 min and never fired before the hard stop (live
# data: 2 EMA_CROSS exits in 43 trades, both losers).
S2_STRUCTURE_EXIT_ENABLED=1
S2_STRUCTURE_EXIT_BARS=2
S2_STRUCTURE_EXIT_MARGIN_PCT=0.0005

# Trading window (America/New_York, HH:MM)
# Entry-hour PnL (Jun 8 – Jul 7 live): S2's only profitable hour was 11:00
# (+$231, 73% win rate); 12:00 was slightly negative, 13:00+ lost.
S2_TRADING_START_TIME=11:00
S2_LAST_ENTRY_TIME=12:30
S2_TRADING_END_TIME=15:30